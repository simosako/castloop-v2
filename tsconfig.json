{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ESNext"],

    "strict": true,
    "noEmit": true,
    "isolatedModules": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "types": ["./worker-configuration.d.ts", "node", "bun"]
  },
  "include": ["packages/**/*.ts", "src/**/*.ts"]
}
