{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CLOUDFLARE_API_TOKEN}"
          }
    }
  }
}
