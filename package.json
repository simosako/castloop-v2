{
  "name": "castloop-v2",
  "version": "0.8.0",
  "description": "castloop is a serverless podcast hosting program. Once deployed, it runs with minimal ops.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "cli": "bun packages/cli/src/index.ts",
    "build:cli": "bun scripts/build-cli.ts"
  },
  "keywords": [
    "podcast",
    "podcasting",
    "cloudflare",
    "cloudflare-workers",
    "r2",
    "durable-objects",
    "serverless",
    "cli",
    "rss"
  ],
  "author": "Akira Shimosako",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simosako/castloop-v2.git"
  },
  "bugs": {
    "url": "https://github.com/simosako/castloop-v2/issues"
  },
  "homepage": "https://github.com/simosako/castloop-v2#readme",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@js-temporal/polyfill": "0.5.1",
    "htmlparser2": "10.1.0",
    "music-metadata": "11.16.0",
    "saxes": "6.0.0",
    "zod": "^4.6.6"
  }
}
